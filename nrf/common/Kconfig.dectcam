# Radio and link settings shared by the dect_cam TX and RX applications.
#
# Both apps source this file so that a setting cannot drift between the two
# ends of the link. Several of them (MCS, packet length, network ID, carrier)
# MUST match on both boards or nothing is received at all.
#
# SPDX-License-Identifier: Apache-2.0

menu "DECT camera link"

comment "Radio"

config DECTCAM_CARRIER
	int "Carrier (absolute channel number)"
	default 1665
	help
	  Band 1 (Europe, 1880-1900 MHz) is channels 1657..1677, and per
	  ETSI EN 301 406-2 V3.0.1 clause 4.3.2.3 only ODD channels may be
	  used there.

	     f = 1881.792 MHz + (n - 1657) * 0.864 MHz

	     1657 -> 1881.792 MHz
	     1665 -> 1888.704 MHz   (default, mid band)
	     1677 -> 1899.072 MHz

	  Other bands: 2 = 1680..1700, 4 = 525..551 (~1 GHz),
	  9 = 1703..1711, 22 = 1691..1711.

	  MUST be identical on the transmitter and the receiver.

	  Check your local regulations before transmitting.

config DECTCAM_BAND_GROUP_INDEX
	int "Band group index"
	range 0 1
	default 0
	help
	  Selects the RF front end: 0 for frequencies near 2 GHz (bands 1, 2,
	  9, 22), 1 for frequencies near 1 GHz (band 4).

	  Leave at 0 for the European 1880-1900 MHz band.

config DECTCAM_NETWORK_ID
	int "Network ID"
	range 1 4294967295
	default 91
	help
	  Identifies this network. The receiver filters on the low 8 bits, so
	  pick a value whose low byte is distinctive if other DECT NR+ gear is
	  nearby.

	  MUST be identical on the transmitter and the receiver.

config DECTCAM_MCS
	int "Modulation and coding scheme"
	range 0 4
	default 4
	help
	  Higher MCS carries more bytes per subslot but needs a better signal.

	  Transport block size in BYTES for the useful packet lengths
	  (mu=1, beta=1), from ETSI TS 103 636-3 section 5.3:

	      subslots:    2     4     8    12    16
	      MCS 0       33    67   133   197   249
	      MCS 1       69   137   263   391   495
	      MCS 2      107   205   399   594   692 (max 15 subslots)
	      MCS 3      141   271   532   660 (max 11 subslots)
	      MCS 4      217   407   700 (max 8 subslots)

	  MCS 4 with 8 subslots gives the largest single transport block
	  (700 B) and so the best efficiency, at the cost of link margin.

	  MUST be identical on the transmitter and the receiver.

config DECTCAM_PACKET_LEN_SUBSLOTS
	int "Packet length in subslots"
	range 1 16
	default 8
	help
	  Air-time length of one transmission. Together with the MCS this
	  fixes the transport block size, and hence the fragment payload.

	  At mu=1 one subslot is 208.33 us, so 8 subslots is 1.67 ms.

	  Not every MCS/length combination is legal; the build fails with a
	  clear message if you pick an unsupported one.

	  MUST be identical on the transmitter and the receiver.

config DECTCAM_TX_POWER
	int "Transmit power index"
	range 0 13
	default 13
	help
	  Index into the transmit power table of ETSI TS 103 636-4 v1.5.1
	  table 6.2.1-3. 13 is the maximum the nRF9151 supports.

	  Reduce this for bench testing: at 13 with the boards on the same
	  desk the receiver front end is heavily overdriven (RSSI around
	  -18 dBm), which is not representative of real behaviour.

comment "Diagnostics"

config DECTCAM_STATS_INTERVAL_MS
	int "Statistics log interval (ms), 0 to disable"
	default 5000

module = DECTCAM
module-str = DECT camera
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

endmenu
