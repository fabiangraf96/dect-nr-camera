/*
 * Receiver on the nRF9131 EK (PCA10165): video over VCOM0, console over RTT.
 *
 *   P0.11 = TX  -> VCOM0 -> host
 *   P0.12 = RX  <- VCOM0 <- host
 *   P0.10 = RTS
 *   P0.09 = CTS
 *
 * No wiring: the receiver needs no header pins at all, on either connector.
 *
 * Why not VCOM1, which is where the DK puts it
 * ---------------------------------------------
 * VCOM1 works, but only for a trickle. Measured with video flowing, the
 * receiver checked its own CRC on every packet the instant the modem handed it
 * over and found not one bad -- 951 fragments queued, 0 corrupt, DECT CRC
 * errors 0, outbound ring never above empty -- and the PC still saw 553 of
 * those 951 arrive with a broken CRC. Clean in, clean out, ruined in between.
 *
 * The reason is that the EK does not connect RTS/CTS on VCOM1. Nothing can
 * tell the receiver to wait, so whenever the interface MCU is busy the bytes
 * in flight are simply gone. It is not a bandwidth problem and it does not
 * respond to the usual levers: baud 1 M, 460800 and 115200 all fail, and the
 * slower ones fail harder; fragment payloads of 687 and 128 bytes fail alike;
 * chunk sizes of 512 and 2048 make no difference; nor does turning off the
 * low-power async mode. Only the tiny packets sent while the line is otherwise
 * idle -- metadata, statistics -- survive reliably.
 *
 * uart0 is the console on VCOM0, and unlike uart1 the board's own device tree
 * gives it a full four-wire pinctrl including RTS and CTS. If those are wired
 * through, this is the port that can carry video. The console moves to RTT,
 * which costs nothing here: it was unusable during streaming anyway, because
 * both virtual COM ports share one USB device and the video starves the
 * console.
 *
 * Instance 3 rather than 2, as everywhere on this board: on the nRF91 each
 * instance number is shared by SPIM, SPIS, TWIM, TWIS and UARTE, instance 2 is
 * the nPM1300's i2c2, and instance 3 is only an already-disabled flash.
 */

/ {
	chosen {
		/* Which instance carries the video, so the source does not have
		 * to know. The two boards cannot agree on a number. */
		dectcam,link-uart = &uart3;

		zephyr,console = &rtt0;
		zephyr,shell-uart = &rtt0;
	};

	rtt0: rtt_chan0 {
		compatible = "segger,rtt-uart";
		status = "okay";
	};
};

/* uart0 owns the VCOM0 pads by default; uart3 is taking them over. */
&uart0 {
	status = "disabled";
};

/* Frees instance 3 for uart3. Only the external flash used it, and that flash
 * is already disabled in the board's device tree. */
&spi3 {
	status = "disabled";
};

&pinctrl {
	uart3_default: uart3_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 11)>,
				<NRF_PSEL(UART_RTS, 0, 10)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 12)>,
				<NRF_PSEL(UART_CTS, 0, 9)>;
			bias-pull-up;
		};
	};

	uart3_sleep: uart3_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 11)>,
				<NRF_PSEL(UART_RX, 0, 12)>,
				<NRF_PSEL(UART_RTS, 0, 10)>,
				<NRF_PSEL(UART_CTS, 0, 9)>;
			low-power-enable;
		};
	};
};

&uart3 {
	status = "okay";
	current-speed = <1000000>;
	hw-flow-control;
	pinctrl-0 = <&uart3_default>;
	pinctrl-1 = <&uart3_sleep>;
	pinctrl-names = "default", "sleep";
};
