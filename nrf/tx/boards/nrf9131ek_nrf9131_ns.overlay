/*
 * Transmitter on the nRF9131 EK (PCA10165): uart3 routed to the left header
 * for the ESP32-S3 camera link.
 *
 *   P0.13 = RX  (from ESP32-S3 GPIO42)
 *   P0.14 = TX  (to   ESP32-S3 GPIO21)
 *   P0.15 = RTS (to   ESP32-S3 GPIO41 / CTS)
 *   P0.16 = CTS (from ESP32-S3 GPIO47 / RTS)
 *
 * One connector only, as required. The EK breaks out P0.13 to P0.31 on the
 * left header and P0.00 to P0.12 on the right, and the left header carries a
 * GND of its own between P0.13 and P0.14 -- so the whole link, ground
 * included, lands on one side of the board.
 *
 * These four are adjacent and genuinely unused: the board's device tree spends
 * P0.17 and P0.23 to P0.25 on VCOM1, P0.20 to P0.22 and P0.26 on spi3, P0.28
 * on the button and P0.29 to P0.31 on the LEDs. That leaves P0.13 to P0.16,
 * P0.18, P0.19 and P0.27 free on this header; the first four are contiguous.
 *
 * The ESP32-S3 side is unchanged from the nRF9151 DK wiring. Only the pin
 * numbers at this end move, which is the point of keeping this in an overlay.
 *
 * Why uart3 and not uart2 as on the DK
 * ------------------------------------
 * On the nRF91 each peripheral instance number is shared by SPIM, SPIS, TWIM,
 * TWIS and UARTE, so only one of them can exist at a time. Instance 2 is taken
 * here by i2c2, which is how the nPM1300 PMIC is reached, and the PMIC powers
 * the board. Instance 3 is taken by spi3, which exists only for an external
 * flash the board already leaves disabled, so that is the one to reclaim.
 *
 * Flow control
 * -------------
 * On the nRF UARTE, hardware flow control is a single CONFIG.HWFC bit covering
 * RTS *and* CTS -- Zephyr offers no RTS-only mode. We want RTS, so we get CTS
 * whether we like it or not.
 *
 * The pull-down on CTS is deliberate, as on the DK. It costs nothing while the
 * ESP32 drives the line, and if that wire is ever missing the input reads as
 * asserted and the transmitter keeps working, rather than floating and
 * behaving unpredictably.
 *
 * VDD_IO raised to 3.0 V
 * -----------------------
 * The board ships with both nPM1300 buck outputs pinned to 1.8 V, which is
 * fine for the video direction (ESP32 3.3 V into a 1.8 V input, clamped safely
 * by the 1 kOhm series resistors) but not for the return path: the ESP32-S3
 * needs 0.75 x 3.3 V = 2.475 V to read a logic high, and 1.8 V never reaches
 * that. With the camera unplugged, measured on the header VDD pin: 1.8 V at
 * the board's default, 3.0 V with the override below.
 *
 * Both BUCK1 and BUCK2 are moved together. Neither is named, labelled, or
 * connected to a documented consumer anywhere in the board's device tree, so
 * there is no way to tell which one is VDD_IO from the files alone; moving
 * only one risks leaving the SiP under-supplied on whichever rail was guessed
 * wrong. 3.0 V rather than the driver's 3.3 V ceiling matches what the nRF9151
 * DK already runs at and what the ESP32-S3 side already tolerates, keeping a
 * margin to the nPM1300's actual maximum instead of testing at it.
 *
 * This changes the level on every pin fed by this rail, uart3 included, which
 * is the point: it moves this board's camera link onto the same 3.0 V regime
 * as the DK, so the same wiring notes apply unchanged -- the two series
 * resistors on the ESP32-to-nRF lines stay mandatory. See docs/wiring.md.
 */

&pmic_main {
	regulators {
		BUCK1 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-init-microvolt = <3000000>;
		};

		BUCK2 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3000000>;
			regulator-init-microvolt = <3000000>;
		};
	};
};

/ {
	chosen {
		/* Which instance carries the camera link, so the source does not
		 * have to know. The two boards cannot agree on a number. */
		dectcam,link-uart = &uart3;
	};
};

/* Frees instance 3 for uart3. Only the external flash used it, and that flash
 * is already disabled in the board's device tree. */
&spi3 {
	status = "disabled";
};

&pinctrl {
	uart3_default: uart3_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 14)>,
				<NRF_PSEL(UART_RTS, 0, 15)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 13)>;
			bias-pull-up;
		};
		group3 {
			/* Driven by the ESP32-S3; pull-down is the safe fallback. */
			psels = <NRF_PSEL(UART_CTS, 0, 16)>;
			bias-pull-down;
		};
	};

	uart3_sleep: uart3_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 14)>,
				<NRF_PSEL(UART_RX, 0, 13)>,
				<NRF_PSEL(UART_RTS, 0, 15)>,
				<NRF_PSEL(UART_CTS, 0, 16)>;
			low-power-enable;
		};
	};
};

&uart3 {
	status = "okay";
	current-speed = <1000000>;
	hw-flow-control;
	pinctrl-0 = <&uart3_default>;
	pinctrl-1 = <&uart3_sleep>;
	pinctrl-names = "default", "sleep";
};
